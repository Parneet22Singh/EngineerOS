# EngineerOS backend configuration
# Copy this file to .env and fill in your values

# --- Browser: WAF-protected sites (Akamai / Cloudflare) ---
# Headless browsers are blocked by WAFs. Set to 'true' to drive a visible Chrome window.
# Override per-scan with --headless / --browser flags for speed on unprotected sites.
BROWSER_CHANNEL=chrome          # chrome | msedge | chromium
BROWSER_HEADED=true             # true (visible) | false (headless)

# --- Lighthouse (optional, for performance audits) ---
# Install with: npm install -g lighthouse
# Set to the path where lighthouse.cmd is installed on your system
ENABLE_LIGHTHOUSE=true
LIGHTHOUSE_BIN=lighthouse.cmd   # or full path to lighthouse.cmd

# --- AI Model (for Module 5: Copilot and Module 4: Knowledge Graph summaries) ---
# Option 1: Local model (requires serve-ai.cmd/ps1 running separately)
AI_PROVIDER=openai
AI_MODEL=qwen2.5-coder-3b
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-local

# Option 2: Cloud provider (faster, costs per use)
# Uncomment ONE of the below and add your API key
#
# For Anthropic:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...
#
# For OpenAI:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4-turbo
# OPENAI_API_KEY=sk-...

# --- Database (optional, defaults to SQLite) ---
# Leave commented to use SQLite (engineeros.db in backend/)
# Or set a PostgreSQL URL to use a remote database
# DATABASE_URL=postgresql://user:password@host:5432/engineeros
