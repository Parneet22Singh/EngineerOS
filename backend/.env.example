# EngineerOS backend configuration

# Storage — SQLite by default. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/engineeros
DATABASE_URL=sqlite+aiosqlite:///./engineeros.db

# Where scan artifacts (screenshots, reports) are written
ARTIFACTS_DIR=./artifacts

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Crawler defaults (overridable per-scan) ---
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_MS=30000
CRAWL_CONCURRENCY=4
RESPECT_ROBOTS=true

# --- Lighthouse (optional) ---
# Path to the lighthouse CLI. Leave as "lighthouse" if on PATH; audits skip if missing.
LIGHTHOUSE_BIN=lighthouse
ENABLE_LIGHTHOUSE=true

# --- Shared AI layer (optional; used by report narration + future modules) ---
# Provider: anthropic | openai | ollama | none
AI_PROVIDER=none
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
